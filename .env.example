# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Secure server-side activity integrations. Never expose these in Vite/client variables.
# Set FIREBASE_SERVICE_ACCOUNT_JSON to a one-line Firebase Admin service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Generate with: openssl rand -base64 32
INTEGRATION_TOKEN_ENCRYPTION_KEY=""
FITBIT_STATE_SECRET=""
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
# Must exactly match the callback registered in the Fitbit developer console.
FITBIT_REDIRECT_URI="http://localhost:3000/api/activity-sources/fitbit/callback"
